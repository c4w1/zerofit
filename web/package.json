{
  "name": "zerofit-web",
  "version": "0.1.0",
  "private": true,
  "description": "Client-side training analysis: FIT decoding, analytics and fueling in WebAssembly, in your browser",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "demo": "node scripts/copy-demo.mjs",
    "prepare-assets": "npm run wasm && npm run demo",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "binaryen": "132.0.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "uplot": "1.6.32"
  }
}
